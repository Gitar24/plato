# Copie este arquivo para .env e preencha
# Preencha a chave do LLM escolhido em config/config.json (llm.provider: gemini ou anthropic)
# Chave Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Pasta do vault do Obsidian neste computador
# Windows: C:/Users/voce/Documents/MeuVault   Linux: /home/voce/Documentos/MeuVault
OBSIDIAN_VAULT_PATH=C:/Users/voce/Documents/MeuVault
# production (a cada 15 ou 7 min) ou test (a cada 60 ou 30 s). Vale mais que o "mode" do config.json
NEWS_MODE=production
# Só no Linux: seu usuário e grupo (id -u e id -g), para as notas não saírem como root
# PUID=1000
# PGID=1000
